{
  "name": "unify-academy",
  "private": true,
  "scripts": {
    "assets:env": "python3 tools/gen_env.py",
    "assets:chars": "python3 tools/gen_chars.py",
    "assets:layout": "python3 tools/layout.py",
    "assets:pack": "python3 tools/pack_atlas.py",
    "assets:validate": "python3 tools/validate.py",
    "assets:preview": "python3 tools/preview.py",
    "assets": "npm run assets:env && npm run assets:chars && npm run assets:layout && npm run assets:pack && npm run assets:validate && npm run assets:preview",
    "typecheck": "tsc --noEmit",
    "demo": "esbuild demo/main.ts --bundle --format=iife --outfile=demo/dist/bundle.js --alias:phaser=./demo/phaser-shim.ts",
    "build": "esbuild demo/main.ts --bundle --minify --format=iife --outfile=demo/dist/bundle.js",
    "start": "node server/server.mjs",
    "dev": "npm run build && npm start",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "esbuild": "^0.23.0",
    "@types/react": "^18.3.0"
  },
  "type": null,
  "description": "UNIFY Academy: hallway sim, isometric lecture auditoriums, and the live news studio"
}
