rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own phone data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.method == 'delete' || request.resource.size() < 1000000);
    }
    // Parent links: anyone holding the long random code can read one document until it expires (no listing);
    // only the student who created it can change or delete it. It never contains chats.
    match /shares/{code} {
      allow get: if resource.data.expiresMs > request.time.toMillis();
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.size() < 1000000;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.size() < 1000000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
